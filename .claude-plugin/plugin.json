  "keywords": [
    "aidlc",
    "AI-DLC",
    "完整闭环",
    "继续上次的工作",
    "认领单元",
    "团队协作模式",
    "loeyae",
    "功能设计",
    "用户故事",
    "架构设计",
    "单元生成",
    "代码审查",
    "逆向工程",
    "根因分析",
    "TDD",
    "两阶段审查"
